{
	"name": "tradelovin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint",
		"test:lab": "node --loader ./tests/lab/ts-loader.mjs --test tests/lab/p0.test.ts tests/lab/spike.test.ts",
		"test:membership": "node --loader ./tests/lab/ts-loader.mjs --test tests/membership/home-upgrade-cta.test.ts",
		"spike:lab:check": "npx tsx scripts/lab/spike-check.ts",
		"clean:open-next": "node scripts/clean-open-next.mjs",
		"build:cloudflare": "npm run clean:open-next && opennextjs-cloudflare build && npm run debug:opennext",
		"debug:opennext": "node -e \"const fs=require('fs'),path=require('path');const p='.open-next';console.log('=== .open-next ===');try{for(const n of fs.readdirSync(p)){const s=fs.statSync(path.join(p,n));console.log((s.isDirectory()?'d':'-')+' '+n);}}catch(e){console.log('(missing or unreadable) '+e.message);}console.log('---');const w=path.join('.open-next','worker.js');console.log(fs.existsSync(w)?'worker.js OK':'worker.js NOT FOUND');\"",
		"preview": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"preview:cloudflare": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy --config wrangler.jsonc",
		"smoke:api": "node scripts/deploy/api-smoke.mjs",
		"smoke:auth-magic-link": "node scripts/deploy/auth-magic-link-smoke.mjs",
		"smoke:trade-v2": "npm run verify:trade-execution-messages && node scripts/deploy/trade-v2-e2e-smoke.mjs",
		"test:contracts:xeoaxis": "node --test tests/lib/site-entries.contract.test.mjs tests/lib/site/resolve-asset-prefix.contract.test.mjs tests/lib/auth/magic-link-origin.contract.test.mjs tests/lib/auth/session-handoff.contract.test.mjs tests/lib/site/legacy-overseas-redirect.contract.test.mjs tests/middleware/legacy-overseas-redirect-wiring.contract.test.mjs tests/ci/xeoaxis-entry-smoke-gate.contract.test.mjs tests/staff-pay/staff-pay-wiring.contract.test.mjs",
		"smoke:xeoaxis": "node scripts/deploy/xeoaxis-entry-smoke.mjs",
		"sync:generated": "npm run sync:trade-execution-messages",
		"sync:trade-execution-messages": "node scripts/shared/sync-trade-execution-messages.mjs",
		"verify:generated": "npm run verify:trade-execution-messages",
		"verify:trade-execution-messages": "node scripts/shared/sync-trade-execution-messages.mjs --check",
		"verify:trade-v2-consistency": "npm run verify:trade-execution-messages && node scripts/ci/trade-v2-consistency-check.mjs",
		"verify:trade-session-redirect": "node scripts/ci/check-trade-session-redirect-regression.mjs",
		"upload": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
		"test:assessment": "node --loader ./tests/lab/ts-loader.mjs --test tests/assessment/dashboard.test.ts",
		"test:trade-v2-session-settings": "node --loader ./tests/lab/ts-loader.mjs --test tests/trade-v2/session-settings.test.ts",
		"test:notices": "node --loader ./tests/lab/ts-loader.mjs --test tests/notices/notices.test.ts",
		"test:staff-pay": "node --loader ./tests/lab/ts-loader.mjs --test tests/staff-pay/staff-pay.test.ts",
		"test:contracts:staff-pay": "node --test tests/staff-pay/staff-pay-wiring.contract.test.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1047.0",
		"@aws-sdk/s3-request-presigner": "^3.1047.0",
		"@base-ui/react": "^1.4.1",
		"@hookform/resolvers": "^5.2.2",
		"@opennextjs/cloudflare": "^1.19.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@react-email/render": "^2.0.7",
		"@resvg/resvg-js": "^2.6.2",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.3",
		"@stripe/react-stripe-js": "^6.3.0",
		"@stripe/stripe-js": "^9.4.0",
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.104.1",
		"@swc/helpers": "^0.5.21",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"iconv-lite": "^0.7.2",
		"jose": "^6.2.2",
		"lucide-react": "^1.9.0",
		"next": "16.2.4",
		"next-intl": "^4.9.1",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.73.1",
		"resend": "^6.12.2",
		"shadcn": "^4.4.0",
		"sonner": "^2.0.7",
		"stripe": "^22.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.4",
		"opencc-js": "^1.0.5",
		"tailwindcss": "^4",
		"typescript": "^5",
		"wrangler": "^4.85.0"
	}
}
