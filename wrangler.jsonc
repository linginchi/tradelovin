{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "tradelovin",
	"account_id": "3776aaf92edc5404ea26d4f815ac0c32",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://tradelovin.com",
		"NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_xxx",
		"NEXT_PUBLIC_STRIPE_PUBLIC_KEY": "pk_live_xxx",
		"PRICE_T1_MONTHLY": "price_T1_monthly",
		"PRICE_T1_YEARLY": "price_T1_yearly",
		"PRICE_T2_MONTHLY": "price_T2_monthly",
		"PRICE_T2_YEARLY": "price_T2_yearly",
		"PRICE_T3_MONTHLY": "price_T3_monthly",
		"PRICE_T3_YEARLY": "price_T3_yearly",
		"STRIPE_PRICE_T1_MONTHLY": "price_T1_monthly",
		"STRIPE_PRICE_T1_YEARLY": "price_T1_yearly",
		"STRIPE_PRICE_T2_MONTHLY": "price_T2_monthly",
		"STRIPE_PRICE_T2_YEARLY": "price_T2_yearly",
		"STRIPE_PRICE_T3_MONTHLY": "price_T3_monthly",
		"STRIPE_PRICE_T3_YEARLY": "price_T3_yearly",
		"TQ_CRON_TIMEZONE": "Asia/Hong_Kong",
		"TQ_CRON_TARGET_HOUR": "16",
		"ENABLE_DEV_TEST_ACCOUNTS": "1",
		"ENABLE_DEV_TEST_ACCOUNTS_IN_PRODUCTION": "1"
	}
}
