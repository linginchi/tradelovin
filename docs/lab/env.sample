# 复制到本地 .env.local 或 .dev.vars（勿提交仓库）
# 生成：openssl rand -hex 32

LAB_SSO_SECRET=
LAB_DOJO_SERVER_KEY=

# VPS 就绪后再填，例如 https://lab.leolearnstotrade.com
# LAB_PUBLIC_BASE_URL=

# --- Spike runner（VPS 或可达 lab 的机器；本机无 URL 时会 fail closed）---
# LAB_SPIKE_LAB_BASE_URL=   # 可选，覆盖 LAB_PUBLIC_BASE_URL
# GEMINI_API_KEY=           # Gate B/C 仅在 VPS Dojo 内使用；runner 不读取、不上传
# MAIN_APP_BASE_URL=        # Gate D SSO 联调
